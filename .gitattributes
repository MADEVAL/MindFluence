# Line endings: keep LF in the repository and in the working tree on every OS.
* text=auto eol=lf

*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.ps1   text eol=lf
*.toml  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.php   text eol=lf
*.xml   text eol=lf
*.po    text eol=lf
*.pot   text eol=lf
*.neon  text eol=lf
*.svg   text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

